version: '3.8'

services:
  prometheus:
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    depends_on:
      - nginx
      - cpu-sw
  nginx:
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nginx
    container_name: nginx
    ports:
      - "8080:80"
  grafana:
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/grafana/grafana:latest
    container_name: grafana
    ports:
      - "3000:3000"
    depends_on:
      - prometheus
  nginx-sw:
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nginx/nginx-prometheus-exporter:1.5.1
    container_name: nginx-exporter
    command:
        - -nginx.scrape-uri=http://nginx:80/stub_status
    depends_on:
        - nginx
  cpu-sw:
    image: swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/rancher/mirrored-prometheus-node-exporter:v1.9.0
    container_name: cpu-exporter
